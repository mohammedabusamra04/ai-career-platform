PORT=3000
NODE_ENV=development
TELEGRAM_BOT_TOKEN=your_bot_token
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=your_api_key_here
PIPELINE_API_SECRET=your_secure_pipeline_api_secret_here

# Twice-daily scheduling configuration & timezone
JOB_RUN_TIME_1=09:00
JOB_RUN_TIME_2=18:00
TIMEZONE=Asia/Gaza

# Optional Job Sources (Free credentials):
# Adzuna API (Free developer account: https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble API (Free developer account: https://jooble.org/api/about)
JOOBLE_API_KEY=

# Optional Fallback: JSearch (RapidAPI) for LinkedIn
RAPIDAPI_KEY=

# Firecrawl API (Free account: https://www.firecrawl.dev/)
FIRECRAWL_API_KEY=

# Matching score threshold (0-100, default is 40)
MIN_MATCH_SCORE=40
